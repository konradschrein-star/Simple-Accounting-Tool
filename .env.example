# ── Host ────────────────────────────────────────────────────────────────
# Free wildcard DNS: replace dots in your VPS IP with dashes, e.g. 203-0-113-7.sslip.io
APP_HOST=203-0-113-7.sslip.io
# Must be written out literally (no ${...} interpolation in env files)
BETTER_AUTH_URL=https://203-0-113-7.sslip.io
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Google OAuth (console.cloud.google.com → Credentials → OAuth client, Web) ──
# Redirect URI: https://<APP_HOST>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
DATA_DIR=/data
# Comma-separated; these accounts become admins on first sign-in
ADMIN_EMAILS=
BRAND_NAME=Cashflow Compass
# Cal.com / Calendly link opened by the "Request a Strategic Cash-Flow & Growth Plan" CTA
BOOKING_URL=
# Optional: Slack / Make / n8n webhook notified on every lead
LEAD_WEBHOOK_URL=

# ── AI (OpenRouter, zero-data-retention endpoints only) ─────────────────
OPENROUTER_API_KEY=
LLM_TEXT_MODEL=deepseek/deepseek-v4.1-flash
LLM_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
LLM_ESCALATION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# ── Limits & behaviour ──────────────────────────────────────────────────
PDF_IMPORTS_PER_MONTH=10
MAX_PDF_PAGES=30
DELETE_SOURCE_AFTER_COMMIT=true
MARGIN_ALERT_BP=2500
AI_AUTO_ACCEPT=0.85
DEMO_ENABLED=true
DEMO_TTL_HOURS=24

# ── Legal (Impressum / privacy) ─────────────────────────────────────────
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Never enable in production (allows email/password test logins)
E2E=0
